# Tên miền trỏ về IP của VPS (bản ghi A). Caddy tự xin HTTPS cho tên miền này.
API_DOMAIN=ranking.example.com

# Chỉ dùng chữ và số, vì nó nằm trong URL kết nối. Tạo bằng: openssl rand -hex 24
POSTGRES_PASSWORD=

# Discord Developer Portal → Applications → ứng dụng của bạn → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Phải trùng khớp tuyệt đối với Redirect đã khai trong Discord. Nhiều giá trị thì cách nhau bằng dấu phẩy.
# Mục đầu là cho bản web (nhớ dấu / ở cuối), mục sau là cho extension — bỏ mục nào không dùng.
DISCORD_REDIRECT_URIS=https://ranking.example.com/,https://<extension-id>.chromiumapp.org/discord

# Tên hiện trên trang web
BOARD_NAME=Bảng Xếp Hạng

# Discord user ID của admin (bật Developer Mode trong Discord → chuột phải vào tên → Copy User ID)
ADMIN_DISCORD_IDS=
