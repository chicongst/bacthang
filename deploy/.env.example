# Domain pointing at the VPS (an A record). Caddy requests HTTPS for this name automatically.
API_DOMAIN=ranking.example.com

# Letters and digits only, because it goes inside the connection URL. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Discord Developer Portal > Applications > your application > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match the redirect registered in Discord exactly, including the trailing slash.
# Separate several values with commas.
DISCORD_REDIRECT_URIS=https://ranking.example.com/

# Board name shown on the website
BOARD_NAME=Bảng Xếp Hạng

# The API sits behind Caddy in this setup, so the real client IP arrives in
# X-Forwarded-For and the rate limiter must trust it. Set this to false if you
# ever expose the API directly.
TRUST_PROXY=true

# Discord user IDs of the admins (turn on Developer Mode in Discord, right click a name, Copy User ID)
ADMIN_DISCORD_IDS=
