# Địa chỉ API trên VPS (không có dấu / ở cuối)
VITE_API_BASE=https://ranking.example.com
# Discord Developer Portal → OAuth2 → Client ID
VITE_DISCORD_CLIENT_ID=
# Tên bảng, hiện trên đầu popup và làm tên extension. Môn nào cũng được, không riêng bida.
VITE_BOARD_NAME=Bảng Xếp Hạng
# Tên hiện trên Chrome Web Store (khác tên trong app, để nhét từ khóa tìm kiếm)
VITE_EXTENSION_NAME=Bảng Xếp Hạng — Tính điểm & leo rank
# Trang giới thiệu, hiện ở mục "Website" trên store
VITE_HOMEPAGE=https://103.101.163.42.sslip.io
